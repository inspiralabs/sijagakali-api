# Supabase
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_secret>
SUPABASE_STORAGE_BUCKET_CCTV_IMAGES=cctv-images

# MQTT Broker (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=sijagaair

# Slug deployment default
DEFAULT_DEPLOYMENT_SLUG=sijagaair-bojong-kulur
