# Supabase
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_secret>
SUPABASE_STORAGE_BUCKET_CCTV_IMAGES=cctv-images

# URL dashboard publik — ditampilkan di isi pesan WhatsApp
DASHBOARD_URL=https://sijagaair.example.id/public

# WhatsApp Channel ID (format: 120363426015806462@newsletter)
# - Jika diisi  → kirim langsung ke channel ini tanpa deteksi otomatis
# - Jika kosong → service akan auto-detect channel pertama dari akun yang login
# Cara cari ID: jalankan service, scan QR, lihat log "Daftar channel yang tersedia"
WHATSAPP_CHANNEL_ID=

# Nomor WhatsApp akun yang akan scan QR (hanya untuk referensi log)
WHATSAPP_OWNER_NUMBER=6281xxxxxxxx

# Path to Chrome executable (for headless mode)
PUPPETEER_EXECUTABLE_PATH=