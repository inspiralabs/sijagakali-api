# Supabase (service_role untuk membuat signed URL Storage)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_secret>
SUPABASE_STORAGE_BUCKET_CCTV_IMAGES=cctv-images

# MQTT — untuk publish config/interval ke perangkat
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=sijagakali

# Deployment default
DEFAULT_DEPLOYMENT_SLUG=sijagakali-bojong-kulur

# Fastify server
FASTIFY_PORT=3100

# CORS
ALLOWED_ORIGIN=http://localhost:5173
