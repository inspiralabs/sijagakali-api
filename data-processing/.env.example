# Supabase (gunakan service_role)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_secret>

# Slug deployment default
DEFAULT_DEPLOYMENT_SLUG=sijagakali-bojong-kulur

# Polling fallback mqtt_ingestion (ms); dilewati saat Realtime SUBSCRIBED
INGESTION_POLL_INTERVAL_MS=60000
# Debounce gabung sensor_data + cctv_image per correlation_id (ms)
DISPATCH_DEBOUNCE_MS=3000
