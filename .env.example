# Salin ke .env dan isi nilai asli (jangan commit .env)

# Pooling (koneksi app)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrasi DDL — prefer host direct (cek dashboard Supabase → Database → Connection string)
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_secret>
SUPABASE_STORAGE_BUCKET_CCTV_IMAGES=cctv-images

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=sijagakali

# Deployment
DEFAULT_DEPLOYMENT_SLUG=sijagakali-bojong-kulur

# API service (Fastify)
FASTIFY_PORT=3100
ALLOWED_ORIGIN=http://localhost:5173

# notification-gateway HTTP internal port (digunakan oleh api untuk proxy test)
GATEWAY_HTTP_PORT=3101

# WhatsApp Channel (notification-gateway)
# ID channel (format: 120363426015806462@newsletter)
# Kosongkan → auto-detect channel pertama dari akun yang scan QR
WHATSAPP_CHANNEL_ID=
# Nomor WhatsApp akun yang scan QR (hanya referensi log)
WHATSAPP_OWNER_NUMBER=
# URL dashboard publik — ditampilkan di isi pesan
DASHBOARD_URL=https://sijagakali.example.id/public
